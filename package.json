{
  "name": "forsage-cell-editor",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node -e \"const fs=require('fs');const p='index.html';if(!fs.readFileSync(p,'utf8').includes('/src/main.jsx'))fs.copyFileSync('index.dev.html',p)\" && vite",
    "build": "vite build",
    "build:pages": "VITE_BASE_PATH=/adv_calc/ vite build",
    "deploy:pages": "node scripts/deploy-pages.mjs",
    "preview": "vite preview",
    "preview:pages": "VITE_BASE_PATH=/adv_calc/ vite preview"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.5.2",
    "vite": "^6.3.5"
  }
}
